<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.beestream</groupId>
  <artifactId>spark-jitudf-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>spark-jitudf</name>
  <description>
    GPU-compiled Spark UDFs, through TornadoVM. Compiles a JVM UDF that the RAPIDS udf-compiler
    declined into a GPU kernel, and runs it over the cuDF column buffers in place.
  </description>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>spark-jitudf-plugin</module>
    <module>spark-jitudf-bench</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
    <spark.version>4.0.4</spark.version>
    <scala.binary.version>2.13</scala.binary.version>
    <rapids.version>26.08.1</rapids.version>
    <!-- The cuDF JNI artifact. The released com.nvidia:spark-rapids-jni:26.08.0 carries a
         ColumnView.transform that takes one input column and always produces INT32; the
         multi-input, typed-output, null-aware form this integration calls is the widened binding,
         built from NVIDIA's own pinned sources with our patch applied (see the cudf-spark fork's
         upstream-patches/). It is published under a distinct version so that NVIDIA's released
         26.08.0 is never overwritten, and so that a jar carrying the wider API cannot be confused
         with one that does not. Build it with `mvn install` in a cudf-spark-jni checkout at the
         pinned revision; `-Dcudf.jni.version=26.08.0` builds against the released one instead, with
         the generalized calls left out of the compilation. -->
    <cudf.jni.version>26.08.0-tcudf</cudf.jni.version>
    <cudf.jni.classifier>cuda12</cudf.jni.classifier>
    <!-- A published TornadoVM release, from Maven Central. This build needed a local `develop`
         install until 2026-11-24, because the driver-side cuDF backend calls
         TcCompiler.compileDeviceFunction and no release carried it; 8.2.0 is the first that does,
         so nothing here has to be built by hand any more.

         Running on a GPU still needs a built TornadoVM SDK with the CUDA backend (TORNADO_SDK),
         for the runtime-based backend only. The cuDF backend needs no TornadoVM at run time at
         all, because it compiles on the driver and ships a string, which is why these artifacts
         are on the driver's class path and absent from the executors entirely. -->
    <tornado.version>8.2.0-jdk21</tornado.version>
    <asm.version>9.7.1</asm.version>
    <junit.version>5.10.2</junit.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-sql_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>
      <!-- The RAPIDS distribution jar: RapidsUDF, the plugin, and the ai.rapids.cudf classes.
           Compiled against the released jar; at run time the patched one from
           scripts/build-rapids-patch.sh takes its place, which is what carries the fallback. -->
      <!-- AlsProbe asks whether Spark's own ALS prediction UDF reaches a kernel unmodified. -->
      <dependency>
        <groupId>org.apache.spark</groupId>
        <artifactId>spark-mllib_${scala.binary.version}</artifactId>
        <version>${spark.version}</version>
      </dependency>
      <dependency>
        <groupId>com.nvidia</groupId>
        <artifactId>spark-rapids-jni</artifactId>
        <version>${cudf.jni.version}</version>
        <classifier>${cudf.jni.classifier}</classifier>
      </dependency>
      <dependency>
        <groupId>com.nvidia</groupId>
        <artifactId>rapids-4-spark_${scala.binary.version}</artifactId>
        <version>${rapids.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.beehive-lab</groupId>
        <artifactId>tornado-api</artifactId>
        <version>${tornado.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.beehive-lab</groupId>
        <artifactId>tornado-runtime</artifactId>
        <version>${tornado.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-tree</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-analysis</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.ow2.asm</groupId>
        <artifactId>asm-util</artifactId>
        <version>${asm.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.2.5</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-shade-plugin</artifactId>
          <version>3.5.3</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
